    },
    "RAG Query Service": {
      "main": [[{"node": "Ollama Generate Script", "type": "main", "index": 0}]]
    },
    "Ollama Generate Script": {
      "main": [[{"node": "Build Storyboard", "type": "main", "index": 0}]]
    },
    "Build Storyboard": {
      "main": [
        [
          {"node": "Generate TTS", "type": "main", "index": 0},
          {"node": "Generate Images", "type": "main", "index": 0},
          {"node": "Generate Subtitles", "type": "main", "index": 0}
        ]
      ]
    },
    "Generate TTS": {
      "main": [[{"node": "Render Video", "type": "main", "index": 0}]]
    },
    "Generate Images": {
      "main": [[{"node": "Render Video", "type": "main", "index": 0}]]
    },
    "Generate Subtitles": {
      "main": [[{"node": "Render Video", "type": "main", "index": 0}]]
    },
    "Render Video": {
      "main": [[{"node": "Validate Video", "type": "main", "index": 0}]]
    },
    "Validate Video": {
      "main": [[{"node": "IF QA PASS", "type": "main", "index": 0}]]
    },
    "IF QA PASS": {
      "main": [
        [{"node": "Write Success Report", "type": "main", "index": 0}],
        []
      ]
    }
  },
