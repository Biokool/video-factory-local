{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storyboard V8",
  "type": "object",
  "required": ["video", "scenes"],
  "additionalProperties": false,
  "properties": {
    "video": {
      "type": "object",
      "required": ["topic", "language", "commercial_mode"],
      "additionalProperties": false,
      "properties": {
        "topic": {"type": "string", "minLength": 3, "maxLength": 160},
        "language": {"const": "es-MX"},
        "commercial_mode": {"type": "boolean"},
        "profile": {"type": "string"},
        "title": {"type": "string"},
        "hook": {"type": "string"},
        "project_id": {"type": "string"},
        "target_duration_sec": {"type": "number"}
      }
    },
    "project_id": {"type": "string"},
    "profile": {"type": "string"},
    "title": {"type": "string"},
    "hook": {"type": "string"},
    "target_duration_sec": {"type": "number"},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "duration_sec", "narration", "concept_ids", "source_refs", "asset_ids"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "integer", "minimum": 1},
          "duration_sec": {"type": "number", "minimum": 1, "maximum": 90},
          "narration": {"type": "string", "minLength": 1},
          "concept_ids": {"type": "array", "items": {"type": "string"}},
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["pdf_page"],
              "additionalProperties": true,
              "properties": {"pdf_page": {"type": "integer", "minimum": 1}}
            }
          },
          "asset_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[A-Z0-9_]+_V[0-9]{3}$"}
          },
          "animation": {
            "enum": ["none", "fade_in", "slow_zoom", "slow_zoom_in", "draw_line",
                     "highlight", "compare_hands", "pan_to_zone", "crossfade"]
          },
          "effect": {"type": "string"},
          "image": {"type": "string"},
          "voice": {"type": "string"},
          "subtitle": {"type": "string"},
          "visual_prompt": {"type": "string"},
          "on_screen_text": {"type": "string"},
          "source_chunk_ids": {"type": "array"},
          "scene_type": {"type": "string"}
        }
      }
    }
  }
}
