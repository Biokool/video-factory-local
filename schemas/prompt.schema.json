{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "prompt_id",
    "asset_id",
    "positive",
    "negative",
    "status"
  ],
  "properties": {
    "prompt_id": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "positive": {
      "type": "string"
    },
    "negative": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "APPROVED",
        "RETIRED"
      ]
    },
    "text_in_image": {
      "const": false
    },
    "expected_finger_count": {
      "type": "integer",
      "const": 5
    }
  }
}
